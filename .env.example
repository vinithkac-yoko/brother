# Copy to .env and fill in before running migrations / the app.
#
# Local dev: values below point at a local Postgres. Prisma looks for .env
# next to wherever it's invoked from, not necessarily the repo root — if
# `pnpm db:migrate` etc. can't find DATABASE_URL, symlink this file into
# packages/core/.env (see claude-progress.md "How to run everything").
#
# Railway: do NOT set DATABASE_URL manually in the Railway dashboard —
# attach the Postgres plugin and add a variable *reference* to its
# DATABASE_URL instead, so it stays in sync if Railway ever rotates
# credentials. ANTHROPIC_API_KEY still has to be set by hand.

# Postgres connection string used by packages/core (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/fab_erp?schema=public"

# Anthropic API key used by packages/agent (Claude Agent SDK).
ANTHROPIC_API_KEY=""

# Injected automatically by Railway — do not set locally.
# PORT=3000
