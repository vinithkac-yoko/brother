// fab-erp-template — Layer 1 (ERP Core) data model
//
// Conventions:
// - Soft deletes everywhere: `deletedAt DateTime?`. Services filter it; nothing is hard-deleted.
// - Money is always an integer number of paise (never Decimal/Float) — field names end in `Paise`.
// - Human-readable sequence numbers (inquiryNumber, quoteNumber, jobNumber, poNumber) are
//   generated by services, not the DB — stored here as unique strings.
// - `JobCard` is intentionally NOT a table: it's a read-only view assembled by a core service
//   from Job + ProcessRoute + RouteStage + StageUpdate + notes. Persisting it would create a
//   second source of truth for data that already lives in those tables.
// - Rates, GST %, payment terms, and the stage list are NOT hardcoded anywhere — they live in
//   ClientConfig, seeded from CUSTOMIZE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ENGINEER
  SUPERVISOR
}

enum ActorType {
  USER
  AGENT
}

enum InquiryStatus {
  NEW
  REVIEWING
  FEASIBILITY
  QUOTED
  WON
  LOST
}

enum LostReason {
  PRICE
  LEAD_TIME
  CAPABILITY_MISMATCH
  CUSTOMER_CANCELLED
  NO_RESPONSE
  OTHER
}

enum DrawingFileType {
  DXF
  SOLIDWORKS
  PDF
  CYPCUT
}

// Some customers hand over a finished drawing; others only describe a
// requirement and the shop's own engineers draw the CAD. That distinction
// is what makes a DrawingCharge applicable.
enum DrawingSource {
  CUSTOMER_SUPPLIED
  SHOP_DRAWN
}

enum DrawingChargeStatus {
  PENDING
  INVOICED
  PAID
  WAIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Billable process categories used on a Quote line item.
enum QuoteProcess {
  RAW_MATERIAL
  SHEET_LASER_CUTTING
  TUBE_LASER_CUTTING
  BENDING
  MIG_WELDING
  BANDSAW_CUTTING
  LASER_WELDING
  GRINDING
  POWDER_COATING
  PACKING
  TRANSPORT
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  SUPERSEDED
  REJECTED
  EXPIRED
}

enum PaymentType {
  ADVANCE
  FINAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
}

enum JobStatus {
  CREATED
  AWAITING_ADVANCE
  PRODUCTION_ELIGIBLE
  IN_PRODUCTION
  DISPATCHED
  CLOSED
  CANCELLED
}

// Ordered production stages (route subset/order chosen per job).
enum RouteStageType {
  SHEET_LASER_CUTTING
  TUBE_LASER_OUTSOURCING
  BENDING
  FABRICATION
  MIG_WELDING
  BANDSAW_CUTTING
  LASER_WELDING
  GRINDING
  POWDER_COATING
  PACKING
  DISPATCH
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum Unit {
  KG
  PIECE
  METER
  SQM
  SET
}

enum PurchaseRequestStatus {
  OPEN
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum VendorPOStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageDraftKind {
  ADVANCE_FOLLOWUP
  QUOTE_COVER
  DISPATCH_CONFIRMATION
}

enum MessageChannel {
  WHATSAPP
  EMAIL
}

// ─────────────────────────────────────────────────────────────────────────
// Identity / config
// ─────────────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  role      Role
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  approvalsProposed Approval[] @relation("ApprovalProposedBy")
  approvalsDecided  Approval[] @relation("ApprovalDecidedBy")
}

// Singleton-ish: one row per deployed client, identified by `slug`. Seeded from CUSTOMIZE.md.
model ClientConfig {
  id                     String   @id @default(cuid())
  slug                   String   @unique @default("default")
  clientName             String
  gstRatePct             Decimal  @default(18.00) @db.Decimal(5, 2)
  advancePct             Int      @default(50)
  balancePct             Int      @default(50)
  quoteValidityDays      Int      @default(15)
  approvalThresholdPaise Int      @default(0)
  transportNote          String   @default("Transport extra as applicable")
  // Map of QuoteProcess -> { basis: string, ratePaise: number, outsourced: boolean }
  processRates           Json
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Customer / Lead
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id              String    @id @default(cuid())
  name            String
  gstin           String?
  billingAddress  String?
  shippingAddress String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  contacts    Contact[]
  inquiries   Inquiry[]
  customerPOs CustomerPO[]
  jobs        Job[]

  @@index([name])
}

model Contact {
  id          String    @id @default(cuid())
  customerId  String
  name        String
  phone       String?
  email       String?
  designation String?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer  Customer  @relation(fields: [customerId], references: [id])
  inquiries Inquiry[]

  @@index([customerId])
}

model Inquiry {
  id                     String        @id @default(cuid())
  inquiryNumber          String        @unique
  customerId             String
  contactId              String?
  requirementDescription String
  material               String
  thickness              Decimal       @db.Decimal(8, 2)
  quantity               Int
  expectedDeliveryDate   DateTime?
  notes                  String?
  status                 InquiryStatus @default(NEW)
  lostReason             LostReason?
  lostReasonNotes        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  customer          Customer           @relation(fields: [customerId], references: [id])
  contact           Contact?           @relation(fields: [contactId], references: [id])
  drawings          Drawing[]
  drawingCharges    DrawingCharge[]
  feasibilityChecks FeasibilityCheck[]
  quotes            Quote[]
  job               Job?

  @@index([customerId])
  @@index([status])
}

model Drawing {
  id          String          @id @default(cuid())
  inquiryId   String
  fileRef     String
  fileType    DrawingFileType
  // Whether the customer supplied this drawing or the shop drew the CAD
  // in-house from a bare requirement description. SHOP_DRAWN is what makes
  // a DrawingCharge applicable.
  source      DrawingSource   @default(CUSTOMER_SUPPLIED)
  version     Int             @default(1)
  reviewNotes String?
  // Missing-info / attention flags, e.g. "missing powder coat color", "no tolerance spec"
  flags       String[]        @default([])
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  inquiry        Inquiry         @relation(fields: [inquiryId], references: [id])
  drawingCharges DrawingCharge[]

  @@index([inquiryId])
}

// A charge for CAD/drawing creation work the shop performed itself
// (Drawing.source = SHOP_DRAWN). Deliberately separate from Quote/
// QuoteLineItem: it applies whether or not the underlying part turns out
// feasible to manufacture, so it cannot be gated on a production Quote
// existing. The amount is set by a human (owner/engineer judgment call per
// job) rather than computed from a rate-card formula, unlike other
// QuoteLineItem processes.
model DrawingCharge {
  id          String              @id @default(cuid())
  inquiryId   String
  drawingId   String?
  amountPaise Int
  status      DrawingChargeStatus @default(PENDING)
  description String?
  decidedBy   String?
  invoicedAt  DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  inquiry Inquiry  @relation(fields: [inquiryId], references: [id])
  drawing Drawing? @relation(fields: [drawingId], references: [id])

  @@index([inquiryId])
  @@index([drawingId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Feasibility
// ─────────────────────────────────────────────────────────────────────────

model FeasibilityCheck {
  id                String     @id @default(cuid())
  inquiryId         String
  // Structured checklist per the schema in packages/shared (drawing availability,
  // machine compatibility, outsourcing needs, etc.)
  checklist         Json
  riskLevel         RiskLevel?
  estProductionDays Int?
  missingInfo       String[]   @default([])
  outsourcingNeeded Boolean    @default(false)
  outsourcingNotes  String?
  isComplete        Boolean    @default(false)
  completedBy       String?
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])

  @@index([inquiryId])
}

// ─────────────────────────────────────────────────────────────────────────
// Quote
// ─────────────────────────────────────────────────────────────────────────

model Quote {
  id                   String      @id @default(cuid())
  quoteNumber          String      @unique
  inquiryId            String
  version              Int         @default(1)
  status               QuoteStatus @default(DRAFT)
  subtotalPaise        Int
  gstRatePct           Decimal     @db.Decimal(5, 2)
  gstAmountPaise       Int
  totalPaise           Int
  validityDays         Int
  validUntil           DateTime
  // Snapshot of ClientConfig payment terms at time of quoting, so later config
  // changes never retroactively alter an already-issued quote.
  paymentTermsSnapshot Json
  deliveryBasisNotes   String
  transportNote        String
  preparedBy           String?
  supersedesId         String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  inquiry      Inquiry         @relation(fields: [inquiryId], references: [id])
  lineItems    QuoteLineItem[]
  supersedes   Quote?          @relation("QuoteVersion", fields: [supersedesId], references: [id])
  supersededBy Quote?          @relation("QuoteVersion")
  customerPO   CustomerPO?

  @@index([inquiryId])
  @@index([status])
}

model QuoteLineItem {
  id          String       @id @default(cuid())
  quoteId     String
  process     QuoteProcess
  description String
  qty         Decimal      @db.Decimal(12, 3)
  unit        String
  ratePaise   Int
  amountPaise Int
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
}

// ─────────────────────────────────────────────────────────────────────────
// PO + Payment
// ─────────────────────────────────────────────────────────────────────────

model CustomerPO {
  id          String    @id @default(cuid())
  poNumber    String    @unique
  quoteId     String    @unique
  customerId  String
  poFileRef   String?
  poDate      DateTime
  amountPaise Int
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  quote    Quote     @relation(fields: [quoteId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  job      Job?
  payments Payment[]

  @@index([customerId])
}

model Payment {
  id              String        @id @default(cuid())
  customerPOId    String
  jobId           String?
  type            PaymentType
  amountPaise     Int
  status          PaymentStatus @default(PENDING)
  method          String?
  referenceNumber String?
  confirmedBy     String?
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  customerPO CustomerPO @relation(fields: [customerPOId], references: [id])
  job        Job?       @relation(fields: [jobId], references: [id])

  @@index([customerPOId])
  @@index([jobId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Job (spine)
// ─────────────────────────────────────────────────────────────────────────

model Job {
  id                       String    @id @default(cuid())
  jobNumber                String    @unique
  inquiryId                String    @unique
  customerPOId             String    @unique
  customerId               String
  partName                 String
  quantity                 Int
  material                 String
  thickness                Decimal   @db.Decimal(8, 2)
  drawingRef               String
  deliveryDate             DateTime?
  status                   JobStatus @default(CREATED)
  powderCoatColor          String?
  powderCoatColorConfirmed Boolean   @default(false)
  specialNotes             String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  inquiry          Inquiry           @relation(fields: [inquiryId], references: [id])
  customerPO       CustomerPO        @relation(fields: [customerPOId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  payments         Payment[]
  processRoute     ProcessRoute?
  dispatch         Dispatch?
  purchaseRequests PurchaseRequest[]

  @@index([customerId])
  @@index([status])
}

model ProcessRoute {
  id        String    @id @default(cuid())
  jobId     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  job    Job          @relation(fields: [jobId], references: [id])
  stages RouteStage[]
}

model RouteStage {
  id                 String         @id @default(cuid())
  processRouteId     String
  stage              RouteStageType
  sequence           Int
  status             StageStatus    @default(PENDING)
  qualityCheckpoints String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  processRoute ProcessRoute  @relation(fields: [processRouteId], references: [id])
  stageUpdates StageUpdate[]

  @@unique([processRouteId, sequence])
  @@index([processRouteId])
}

model StageUpdate {
  id            String    @id @default(cuid())
  routeStageId  String
  completedQty  Int
  pendingQty    Int
  remarks       String?
  updatedByName String
  updatedByRole Role
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  routeStage RouteStage @relation(fields: [routeStageId], references: [id])

  @@index([routeStageId])
}

// ─────────────────────────────────────────────────────────────────────────
// Materials / stock / purchasing
// ─────────────────────────────────────────────────────────────────────────

model Material {
  id        String    @id @default(cuid())
  name      String
  type      String
  thickness Decimal?  @db.Decimal(8, 2)
  unit      Unit
  sku       String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stockLevels      StockLevel[]
  purchaseRequests PurchaseRequest[]
  vendorPOs        VendorPO[]

  @@index([type])
}

model StockLevel {
  id         String   @id @default(cuid())
  materialId String
  quantity   Decimal  @db.Decimal(12, 3)
  unit       Unit
  location   String?
  updatedAt  DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
}

model PurchaseRequest {
  id          String                @id @default(cuid())
  materialId  String
  jobId       String?
  requiredQty Decimal               @db.Decimal(12, 3)
  shortageQty Decimal               @db.Decimal(12, 3)
  status      PurchaseRequestStatus @default(OPEN)
  requestedBy String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  material  Material   @relation(fields: [materialId], references: [id])
  job       Job?       @relation(fields: [jobId], references: [id])
  vendorPOs VendorPO[]

  @@index([materialId])
  @@index([jobId])
  @@index([status])
}

model Vendor {
  id               String    @id @default(cuid())
  name             String
  contactPhone     String?
  contactEmail     String?
  processesOffered String[]  @default([])
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  vendorPOs VendorPO[]
}

model VendorPO {
  id                String         @id @default(cuid())
  poNumber          String         @unique
  vendorId          String
  purchaseRequestId String?
  materialId        String?
  process           QuoteProcess?
  qty               Decimal        @db.Decimal(12, 3)
  ratePaise         Int?
  amountPaise       Int?
  status            VendorPOStatus @default(DRAFT)
  expectedDate      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  material        Material?        @relation(fields: [materialId], references: [id])
  goodsReceipts   GoodsReceipt[]

  @@index([vendorId])
  @@index([status])
}

model GoodsReceipt {
  id           String    @id @default(cuid())
  vendorPOId   String
  receivedQty  Decimal   @db.Decimal(12, 3)
  receivedDate DateTime
  receivedBy   String?
  notes        String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  vendorPO VendorPO @relation(fields: [vendorPOId], references: [id])

  @@index([vendorPOId])
}

// ─────────────────────────────────────────────────────────────────────────
// Dispatch
// ─────────────────────────────────────────────────────────────────────────

model Dispatch {
  id                   String    @id @default(cuid())
  jobId                String    @unique
  packingCompleteCheck Boolean   @default(false)
  summary              String?
  dispatchDate         DateTime?
  messageDraftId       String?   @unique
  dispatchedBy         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  job          Job           @relation(fields: [jobId], references: [id])
  messageDraft MessageDraft? @relation(fields: [messageDraftId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// Agent-native plumbing: audit, approvals, message drafts
// ─────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id             String    @id @default(cuid())
  actorType      ActorType
  actorId        String?
  action         String
  entity         String
  entityId       String
  before         Json?
  after          Json?
  conversationId String?
  createdAt      DateTime  @default(now())

  @@index([entity, entityId])
  @@index([conversationId])
  @@index([createdAt])
}

model Approval {
  id              String         @id @default(cuid())
  // Name of the tool call being proposed, e.g. "propose_transaction:create_quote"
  proposedAction  String
  payload         Json
  status          ApprovalStatus @default(PENDING)
  proposedById    String?
  decidedById     String?
  decidedAt       DateTime?
  // Set once execute_approved has actually performed the write. Guards
  // against double-execution (e.g. a double click in the approval inbox) —
  // ApprovalStatus itself has no EXECUTED state, so this is the only
  // record of "has this already run."
  executedAt      DateTime?
  executionResult Json?
  thresholdReason String?
  conversationId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  proposedBy User? @relation("ApprovalProposedBy", fields: [proposedById], references: [id])
  decidedBy  User? @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([status])
  @@index([conversationId])
}

model MessageDraft {
  id              String           @id @default(cuid())
  kind            MessageDraftKind
  channel         MessageChannel
  relatedEntity   String
  relatedEntityId String
  body            String
  generatedBy     String
  createdAt       DateTime         @default(now())

  dispatch Dispatch?

  @@index([relatedEntity, relatedEntityId])
}
